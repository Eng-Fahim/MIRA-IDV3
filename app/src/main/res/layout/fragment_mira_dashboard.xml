<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0E27"
    android:padding="16dp">

    <!-- هيدر -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#1A237E"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="صباح الخير"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="التاريخ"
                android:textColor="#B0BEC5"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الوقت"
                android:textColor="#90CAF9"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 الموقع"
            android:textColor="#78909C"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- KPI -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📊 المخزون"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="#1A1E3A"
            android:orientation="vertical"
            android:gravity="center">
            <TextView android:text="💍" android:textSize="22sp"/>
            <TextView android:id="@+id/tvTotalItems" android:text="5,234" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:text="قطعة" android:textColor="#9FA8DA" android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="#1A1E3A"
            android:orientation="vertical"
            android:gravity="center">
            <TextView android:text="⚖️" android:textSize="22sp"/>
            <TextView android:id="@+id/tvTotalWeight" android:text="12.5 kg" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:text="الوزن" android:textColor="#9FA8DA" android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="#1A1E3A"
            android:orientation="vertical"
            android:gravity="center">
            <TextView android:text="💰" android:textSize="22sp"/>
            <TextView android:id="@+id/tvTotalValue" android:text="$245K" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:text="القيمة" android:textColor="#9FA8DA" android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- مبيعات -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💹 المبيعات"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_marginEnd="3dp"
            android:background="#1B5E20" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/tvSoldToday" android:text="12" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
            <TextView android:text="اليوم" android:textColor="#A5D6A7" android:textSize="10sp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_marginHorizontal="3dp"
            android:background="#0D47A1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/tvSoldWeek" android:text="47" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
            <TextView android:text="الأسبوع" android:textColor="#90CAF9" android:textSize="10sp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_marginStart="3dp"
            android:background="#4A148C" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/tvSoldMonth" android:text="189" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
            <TextView android:text="الشهر" android:textColor="#CE93D8" android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- حالة النظام -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🖥️ حالة النظام"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A1E3A"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
            <View android:id="@+id/indicatorApi" android:layout_width="8dp" android:layout_height="8dp" android:background="#4CAF50" android:layout_marginEnd="8dp"/>
            <TextView android:id="@+id/tvApiStatus" android:text="API: متصل" android:textColor="#81C784" android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
            <View android:id="@+id/indicatorDb" android:layout_width="8dp" android:layout_height="8dp" android:background="#4CAF50" android:layout_marginEnd="8dp"/>
            <TextView android:text="قاعدة البيانات: نشطة" android:textColor="#81C784" android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <View android:id="@+id/indicatorGate" android:layout_width="8dp" android:layout_height="8dp" android:background="#4CAF50" android:layout_marginEnd="8dp"/>
            <TextView android:text="البوابات: 3 متصلة" android:textColor="#81C784" android:textSize="12sp"/>
        </LinearLayout>
        <TextView android:id="@+id/tvLastSync" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="آخر مزامنة" android:textColor="#546E7A" android:textSize="10sp" android:layout_marginTop="6dp" android:gravity="end"/>
    </LinearLayout>

    <!-- نشاط حديث -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📋 نشاط حديث"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:id="@+id/layoutRecentActivity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A1E3A"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <TextView android:id="@+id/tvRecent1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✅ الحدث ١" android:textColor="#B0BEC5" android:textSize="11sp" android:paddingVertical="4dp"/>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2E4A"/>
        <TextView android:id="@+id/tvRecent2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🚨 الحدث ٢" android:textColor="#EF9A9A" android:textSize="11sp" android:paddingVertical="4dp"/>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2E4A"/>
        <TextView android:id="@+id/tvRecent3" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="📋 الحدث ٣" android:textColor="#B0BEC5" android:textSize="11sp" android:paddingVertical="4dp"/>
    </LinearLayout>

    <!-- وصول سريع -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚡ وصول سريع"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:id="@+id/cardScan"
            android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_marginEnd="3dp"
            android:background="#1A1E3A" android:orientation="vertical" android:gravity="center">
            <TextView android:text="📷" android:textSize="24sp"/>
            <TextView android:text="مسح" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cardGate"
            android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_marginHorizontal="3dp"
            android:background="#1A1E3A" android:orientation="vertical" android:gravity="center">
            <TextView android:text="🚪" android:textSize="24sp"/>
            <TextView android:text="بوابة" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cardRadar"
            android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_marginHorizontal="3dp"
            android:background="#1A1E3A" android:orientation="vertical" android:gravity="center">
            <TextView android:text="📡" android:textSize="24sp"/>
            <TextView android:text="رادار" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cardSettings"
            android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_marginHorizontal="3dp"
            android:background="#1A1E3A" android:orientation="vertical" android:gravity="center">
            <TextView android:text="⚙️" android:textSize="24sp"/>
            <TextView android:text="إعدادات" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cardInventory"
            android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_marginHorizontal="3dp"
            android:background="#1A1E3A" android:orientation="vertical" android:gravity="center">
            <TextView android:text="📋" android:textSize="24sp"/>
            <TextView android:text="جرد" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cardReports"
            android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_marginStart="3dp"
            android:background="#1A1E3A" android:orientation="vertical" android:gravity="center">
            <TextView android:text="📊" android:textSize="24sp"/>
            <TextView android:text="تقارير" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- تذييل -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MIRA ID"
            android:textColor="#3F51B5"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Digital Trust Platform"
            android:textColor="#546E7A"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/tvSystemStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟢 جميع الأنظمة تعمل"
            android:textColor="#4CAF50"
            android:textSize="10sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</LinearLayout>
