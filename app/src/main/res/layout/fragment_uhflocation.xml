<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1B2A">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ========== هيدر MIRA Locator ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1A237E"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📍 MIRA Locator"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvLocatorStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍 جاهز"
                android:textColor="#C8E6C9"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ========== حقل البحث ========== -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:background="#1B2838">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="18sp"
                android:layout_gravity="center"
                android:layout_marginEnd="4dp" />

            <EditText
                android:id="@+id/etEPC"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="أدخل Serial أو GTIN-13"
                android:textColor="#FFFFFF"
                android:textColorHint="#78909C"
                android:background="@drawable/edittext_border"
                android:paddingHorizontal="10dp"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnMiraSearch"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:text="بحث"
                android:background="#1A73E8"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:paddingHorizontal="14dp" />
        </LinearLayout>

        <!-- ========== بطاقة معلومات القطعة ========== -->
        <LinearLayout
            android:id="@+id/layoutItemInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="#152030"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <View
                    android:id="@+id/statusIndicator"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/indicator_green"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvItemTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📦 اسم القطعة"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvItemStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_background"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="متاح"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvItemDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏷️ BWA-26000101 | 💎 21K | ⚖️ 5.2g"
                android:textColor="#B0BEC5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvItemLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 المعرض الرئيسي"
                android:textColor="#78909C"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- ========== شاشة تحديد الموقع ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dip"
            android:layout_weight="1">

            <com.example.uhf.view.UhfLocationCanvasView
                android:id="@+id/llChart"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:gravity="center"
                android:background="#0A1628" />
        </LinearLayout>

        <!-- ========== مؤشر قوة الإشارة ========== -->
        <LinearLayout
            android:id="@+id/layoutSignal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="#1B2838"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📶"
                android:textSize="16sp"
                android:layout_marginEnd="8dp" />

            <ProgressBar
                android:id="@+id/signalStrength"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressTint="#4CAF50"
                android:background="#263238" />

            <TextView
                android:id="@+id/tvSignalValue"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="-65 dBm"
                android:textColor="#81C784"
                android:textSize="12sp"
                android:gravity="end"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- ========== شريط النطاق ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1B2838"
            android:paddingHorizontal="8dp"
            tools:ignore="MissingConstraints">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="-"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.example.uhf.view.CircleSeekBar
                android:id="@+id/seekBarPower"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:max="30"
                android:min="5"
                android:progressDrawable="@drawable/seekbar_bg"
                android:splitTrack="false"
                android:thumb="@drawable/shape_seekbar_circle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSearchRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/searchRange"
            android:textColor="#90CAF9"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="4dp"
            android:background="#1B2838"
            tools:ignore="MissingConstraints" />

        <!-- ========== أزرار التحكم ========== -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:background="#1B2838">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp">

                <Button
                    android:id="@+id/btStart"
                    android:text="▶ بدء تحديد الموقع"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="4dp"
                    android:background="#1A73E8"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btStop"
                    android:text="⏹ إيقاف"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:background="#F44336"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
