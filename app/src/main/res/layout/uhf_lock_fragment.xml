<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:scrollbars="vertical"
    android:background="#0D1B2A">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- ========== هيدر MIRA Lock ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1A237E"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔒 MIRA Lock"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvLockStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="جاهز"
                android:textColor="#C8E6C9"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ========== بحث MIRA ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/etLockSearch"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="🔍 ابحث بـ Serial أو GTIN"
                android:textColor="#FFFFFF"
                android:textColorHint="#78909C"
                android:background="@drawable/edittext_border"
                android:paddingHorizontal="10dp" />

            <Button
                android:id="@+id/btnLockSearch"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:text="بحث"
                android:background="#1A73E8"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:paddingHorizontal="14dp" />
        </LinearLayout>

        <!-- ========== بطاقة القطعة ========== -->
        <LinearLayout
            android:id="@+id/layoutLockItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="#152030"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvLockItemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📦 اسم القطعة"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLockItemDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏷️ Serial | 💎 Karat | ⚖️ Weight"
                android:textColor="#B0BEC5"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ========== فلتر التاق ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1B2838"
            android:orientation="vertical"
            android:padding="8dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎯 فلتر (استهداف تاق)"
                android:textColor="#90CAF9"
                android:textSize="13sp"
                android:textStyle="bold"
                android:padding="4dp" />

            <CheckBox
                android:id="@+id/cb_filter_lock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تفعيل"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <EditText
                    android:id="@+id/etPtr_filter_lock"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:inputType="numberSigned"
                    android:text="32"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/edittext_border"
                    android:paddingHorizontal="6dp"
                    android:hint="Ptr" />

                <EditText
                    android:id="@+id/etLen_filter_lock"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:inputType="numberSigned"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/edittext_border"
                    android:paddingHorizontal="6dp"
                    android:hint="Len"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etData_filter_lock"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:hint="بيانات الفلتر (Hex)"
                android:textColor="#FFFFFF"
                android:textColorHint="#78909C"
                android:background="@drawable/edittext_border"
                android:paddingHorizontal="8dp"
                android:layout_marginTop="4dp" />

            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <RadioButton android:id="@+id/rbEPC_filter_lock" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="EPC" android:textColor="#FFFFFF" android:checked="true" />
                <RadioButton android:id="@+id/rbTID_filter_lock" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="TID" android:textColor="#FFFFFF" />
                <RadioButton android:id="@+id/rbUser_filter_lock" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="USER" android:textColor="#FFFFFF" />
            </RadioGroup>
        </LinearLayout>

        <!-- ========== إعدادات القفل ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1B2838"
            android:orientation="vertical"
            android:padding="8dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔐 إعدادات القفل"
                android:textColor="#90CAF9"
                android:textSize="13sp"
                android:textStyle="bold"
                android:padding="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="كلمة المرور:"
                    android:textColor="#B0BEC5"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/EtAccessPwd_Lock"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:hint="00000000"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#78909C"
                    android:background="@drawable/edittext_border"
                    android:paddingHorizontal="8dp"
                    android:inputType="textPassword" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="كود القفل:"
                    android:textColor="#B0BEC5"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etLockCode"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:hint="اضغط لتوليد الكود"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#78909C"
                    android:background="@drawable/edittext_border"
                    android:paddingHorizontal="8dp"
                    android:focusable="false" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠️ القفل يمنع تعديل بيانات التاق. تأكد قبل التنفيذ!"
                android:textColor="#EF9A9A"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- ========== زر القفل ========== -->
        <Button
            android:id="@+id/btnLock"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#F44336"
            android:text="🔒 قفل التاق"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
