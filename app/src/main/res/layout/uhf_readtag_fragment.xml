<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- ========== الشريط العلوي لتحديد نمط القراءة والفلترة ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical">

        <RadioGroup
            android:id="@+id/RgInventory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/RbInventorySingle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔍 فحص فردي"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@drawable/check_text_color2" />

            <RadioButton
                android:id="@+id/RbInventoryLoop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="📦 جرد تجميعي"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@drawable/check_text_color2" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/cbFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ الفلترة"
            android:textSize="12sp"
            android:textColor="#475569" />
    </LinearLayout>

    <!-- ========== أزرار التحكم والعمليات السريعة ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#FFFFFF">

        <CheckBox
            android:id="@+id/cbPhase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phase"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/BtInventory"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="2"
            android:layout_marginEnd="6dp"
            android:background="@drawable/button_bg"
            android:text="بدء القراءة (RFID)"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/BtClear"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="#64748B"
            android:text="مسح"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- ========== قسم الفلترة المتقدمة (مخفي افتراضياً) ========== -->
    <LinearLayout
        android:id="@+id/layout_filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rectangle_bg"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tvPtr" />

            <EditText
                android:id="@+id/etPtr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="numberSigned"
                android:text="32" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(bit)  " />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الطول: " />

            <EditText
                android:id="@+id/etLen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="numberSigned"
                android:text="0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(bit)" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tvData_Read" />

            <EditText
                android:id="@+id/etData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textNoSuggestions"
                android:singleLine="true" />
        </LinearLayout>

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbEPC"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:background="@drawable/rb_bg"
                android:button="@null"
                android:checked="true"
                android:gravity="center"
                android:text="EPC"
                android:textColor="@drawable/check_text_color" />

            <RadioButton
                android:id="@+id/rbTID"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/rb_bg"
                android:button="@null"
                android:gravity="center"
                android:text="TID"
                android:textColor="@drawable/check_text_color" />

            <RadioButton
                android:id="@+id/rbUser"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/rb_bg"
                android:button="@null"
                android:gravity="center"
                android:text="USER"
                android:textColor="@drawable/check_text_color" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:paddingTop="8dp">

            <Button
                android:id="@+id/btSet"
                android:layout_width="120dp"
                android:layout_height="36dp"
                android:background="@drawable/button_bg"
                android:textColor="#FFFFFF"
                android:text="تطبيق الفلتر" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- قسم البحث اليدوي -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <EditText
                    android:id="@+id/etGtinInput"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:hint="🔍 أدخل GTIN-13 أو EPC"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:textSize="13sp"
                    android:background="@drawable/edittext_border"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnCheckGtin"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:background="#1A73E8"
                    android:text="فحص"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:paddingHorizontal="16dp" />
            </LinearLayout>

            <!-- 📊 جدول الجرد التجميعي الموحد (Unified Batch Summary Table) -->
            <TableLayout
                android:id="@+id/tableBatchSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:elevation="3dp"
                android:padding="8dp"
                android:stretchColumns="*"
                android:layout_marginBottom="8dp">

                <!-- رأس الجدول -->
                <TableRow
                    android:background="#1A237E"
                    android:padding="8dp">
                    <TextView
                        android:text="حالة MIRA"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:gravity="center" />
                    <TextView
                        android:text="القطع المقروءة"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:gravity="center" />
                    <TextView
                        android:text="النسبة"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:gravity="center" />
                </TableRow>

                <!-- صف الإجمالي -->
                <TableRow
                    android:background="#F1F5F9"
                    android:padding="8dp">
                    <TextView
                        android:text="📦 إجمالي القطع"
                        android:textColor="#0F172A"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tvBatchTotal"
                        android:text="0"
                        android:textColor="#0F172A"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:gravity="center" />
                    <TextView
                        android:text="100%"
                        android:textColor="#0F172A"
                        android:textSize="11sp"
                        android:gravity="center" />
                </TableRow>

                <!-- صف المصرح -->
                <TableRow
                    android:background="#DCFCE7"
                    android:padding="8dp">
                    <TextView
                        android:text="✅ مصرح (Authorized)"
                        android:textColor="#166534"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tvBatchAllowed"
                        android:text="0"
                        android:textColor="#166534"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:gravity="center" />
                    <TextView
                        android:id="@+id/tvBatchAllowedPct"
                        android:text="0%"
                        android:textColor="#15803D"
                        android:textSize="11sp"
                        android:gravity="center" />
                </TableRow>

                <!-- صف الممنوع -->
                <TableRow
                    android:background="#FEE2E2"
                    android:padding="8dp">
                    <TextView
                        android:text="🚨 ممنوع (Blocked)"
                        android:textColor="#991B1B"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tvBatchBlocked"
                        android:text="0"
                        android:textColor="#991B1B"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:gravity="center" />
                    <TextView
                        android:id="@+id/tvBatchBlockedPct"
                        android:text="0%"
                        android:textColor="#B91C1C"
                        android:textSize="11sp"
                        android:gravity="center" />
                </TableRow>

                <!-- صف المجهول -->
                <TableRow
                    android:background="#FEF3C7"
                    android:padding="8dp">
                    <TextView
                        android:text="⚠️ مجهول (Unknown)"
                        android:textColor="#92400E"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tvBatchUnknown"
                        android:text="0"
                        android:textColor="#92400E"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:gravity="center" />
                    <TextView
                        android:id="@+id/tvBatchUnknownPct"
                        android:text="0%"
                        android:textColor="#B45309"
                        android:textSize="11sp"
                        android:gravity="center" />
                </TableRow>
            </TableLayout>

            <!-- 🟢 بطاقة نتيجة MIRA ID الفردية -->
            <LinearLayout
                android:id="@+id/cardMiraResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/mira_card_background"
                android:padding="0dp"
                android:visibility="gone"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1A237E"
                    android:padding="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🏷️ MIRA Digital Trust™"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvMiraStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_background"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="جاري..."
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutMiraLoading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:indeterminateTint="#1A73E8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="جاري الاستعلام من MIRA..."
                        android:textColor="#666666"
                        android:textSize="12sp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutMiraDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="visible">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginBottom="8dp"
                        android:background="#F5F5F5">

                        <ImageView
                            android:id="@+id/ivMiraItemImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:contentDescription="صورة القطعة"
                            android:visibility="gone"
                            android:padding="4dp" />

                        <ProgressBar
                            android:id="@+id/progressImageLoading"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:visibility="gone"
                            android:indeterminateTint="#1A73E8" />

                        <TextView
                            android:id="@+id/tvNoImagePlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="📸\nلا توجد صورة"
                            android:textColor="#999999"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <View
                            android:id="@+id/statusIndicator"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/circle_indicator"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/tvMiraStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="حالة القطعة"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#2E7D32" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvMiraProductName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📦 اسم المنتج"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvMiraEpcGtin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🏷️ الكود"
                        android:textColor="#777777"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ========== عداد الوقت والجلسة ========== -->
    <LinearLayout
        android:id="@+id/llContinuous"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:background="#FFFFFF"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/tvContinuous"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/workTime" />

        <EditText
            android:id="@+id/etTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="36000000"
            android:inputType="numberDecimal"
            android:maxLength="6"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tvMS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/second" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الوقت: " />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0s" />

        <CheckBox
            android:id="@+id/cbEPC_Tam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EPC+TamperAlarm"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ========== قائمة الوسوم المجلوبة بالمسح ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/layout4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1A237E"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="5"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TAG"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:minWidth="24dp"
                    android:text="0"
                    android:textColor="#FFD54F"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" / "
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#80CBC4"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tvTagCount"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="RSSI"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tv_phase"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <ListView
            android:id="@+id/LvTags"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="4dp"
            android:divider="#E2E8F0"
            android:dividerHeight="1px" />
    </LinearLayout>
</LinearLayout>
