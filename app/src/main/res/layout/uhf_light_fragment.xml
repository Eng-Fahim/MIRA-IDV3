<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1B2A">

    <!-- ========== هيدر MIRA Alert ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#B71C1C"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🚨 MIRA Alert"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvAlertStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏸ متوقف"
            android:textColor="#EF9A9A"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ========== بحث عن قطعة ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#1B2838">

        <EditText
            android:id="@+id/etAlertSearch"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:hint="🔍 ابحث بـ Serial أو GTIN"
            android:textColor="#FFFFFF"
            android:textColorHint="#78909C"
            android:background="@drawable/edittext_border"
            android:paddingHorizontal="10dp"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnAlertSearch"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:text="بحث"
            android:background="#1A73E8"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:paddingHorizontal="14dp" />
    </LinearLayout>

    <!-- ========== بطاقة القطعة ========== -->
    <LinearLayout
        android:id="@+id/layoutAlertItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="#152030"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvAlertItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📦 اسم القطعة"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAlertItemDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏷️ BWA-26000101 | 💎 21K | ⚖️ 5.2g"
            android:textColor="#B0BEC5"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvAlertItemStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ الحالة: غير مصرح"
            android:textColor="#EF9A9A"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- ========== إعدادات الفلتر ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#1B2838">

        <CheckBox
            android:id="@+id/cb_light_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎯 تفعيل الفلتر (استهداف تاق محدد)"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:paddingVertical="4dp" />

        <LinearLayout
            android:id="@+id/layoutFilterOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="Ptr:"
                    android:textColor="#B0BEC5"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etPtr_light_filter"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="32"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/edittext_border"
                    android:paddingHorizontal="8dp"
                    android:inputType="number" />

                <TextView
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="Len:"
                    android:textColor="#B0BEC5"
                    android:textSize="13sp"
                    android:layout_marginStart="8dp" />

                <EditText
                    android:id="@+id/etLen_light_filter"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/edittext_border"
                    android:paddingHorizontal="8dp"
                    android:inputType="number" />
            </LinearLayout>

            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:id="@+id/rbEPC_light_filter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="EPC"
                    android:textColor="#FFFFFF"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbTID_light_filter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TID"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/rbUser_light_filter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="USER"
                    android:textColor="#FFFFFF" />
            </RadioGroup>

            <EditText
                android:id="@+id/etData_light_filter"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:hint="بيانات الفلتر (Hex)"
                android:textColor="#FFFFFF"
                android:textColorHint="#78909C"
                android:background="@drawable/edittext_border"
                android:paddingHorizontal="8dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========== أزرار التحكم ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#1B2838"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn_light_single"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="⚡ وميض مرة"
            android:background="#FF9800"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_light_continuous"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="🚨 إنذار مستمر"
            android:background="#F44336"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ========== منطقة العرض ========== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:id="@+id/layoutAlertAnimation">

            <TextView
                android:id="@+id/tvAlertIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚨"
                android:textSize="64sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvAlertMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اضغط وميض أو إنذار مستمر"
                android:textColor="#546E7A"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
