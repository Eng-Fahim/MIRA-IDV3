<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:scrollbars="vertical"
    android:background="#0D1B2A">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- ========== هيدر MIRA Deactivate ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#B71C1C"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="☠️ MIRA Deactivate"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvDeactivateStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="جاهز"
                android:textColor="#EF9A9A"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ========== تحذير ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#3E2723"
            android:padding="10dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚠️ تحذير: تعطيل RFID نهائي! لا يمكن التراجع."
                android:textColor="#FFAB91"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ========== بحث MIRA ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/etDeactivateSearch"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="🔍 ابحث بـ Serial أو GTIN"
                android:textColor="#FFFFFF"
                android:textColorHint="#78909C"
                android:background="@drawable/edittext_border"
                android:paddingHorizontal="10dp" />

            <Button
                android:id="@+id/btnDeactivateSearch"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:text="بحث"
                android:background="#1A73E8"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:paddingHorizontal="14dp" />
        </LinearLayout>

        <!-- ========== بطاقة القطعة ========== -->
        <LinearLayout
            android:id="@+id/layoutDeactivateItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="#152030"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvDeactivateItemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📦 اسم القطعة"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDeactivateItemDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏷️ Serial | 💎 Karat | ⚖️ Weight"
                android:textColor="#B0BEC5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDeactivateItemRfidStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📡 RFID: نشط"
                android:textColor="#81C784"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- ========== فلتر ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1B2838"
            android:orientation="vertical"
            android:padding="8dp"
            android:layout_marginBottom="8dp">

            <CheckBox
                android:id="@+id/cb_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎯 فلتر (استهداف تاق محدد)"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/llFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/etPtr_filter"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:inputType="numberSigned"
                        android:text="32"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/edittext_border"
                        android:paddingHorizontal="6dp"
                        android:hint="Ptr" />

                    <EditText
                        android:id="@+id/etLen_filter"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:inputType="numberSigned"
                        android:text="96"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/edittext_border"
                        android:paddingHorizontal="6dp"
                        android:hint="Len"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etData_filter"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:hint="بيانات الفلتر (Hex)"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#78909C"
                    android:background="@drawable/edittext_border"
                    android:paddingHorizontal="8dp"
                    android:layout_marginTop="4dp" />

                <RadioGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <RadioButton android:id="@+id/rbEPC_filter" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="EPC" android:textColor="#FFFFFF" android:checked="true" />
                    <RadioButton android:id="@+id/rbTID_filter" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="TID" android:textColor="#FFFFFF" />
                    <RadioButton android:id="@+id/rbUser_filter" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="USER" android:textColor="#FFFFFF" />
                </RadioGroup>
            </LinearLayout>
        </LinearLayout>

        <!-- ========== كلمة المرور ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1B2838"
            android:orientation="vertical"
            android:padding="8dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔑 كلمة مرور التعطيل (Kill Password):"
                android:textColor="#B0BEC5"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/EtAccessPwd_Write"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="00000000 (8 خانات Hex)"
                android:textColor="#FFFFFF"
                android:textColorHint="#78909C"
                android:background="@drawable/edittext_border"
                android:paddingHorizontal="10dp"
                android:inputType="textPassword" />
        </LinearLayout>

        <!-- ========== زر التعطيل ========== -->
        <Button
            android:id="@+id/btnKill"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="☠️ تعطيل RFID نهائياً"
            android:background="#B71C1C"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
