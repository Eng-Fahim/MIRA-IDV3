<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E27"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- هيدر -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="16dp" app:cardElevation="6dp"
            app:cardBackgroundColor="#1A237E" android:layout_marginBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">
                <TextView android:id="@+id/tvGreeting" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="صباح الخير ☀️" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="6dp">
                    <TextView android:id="@+id/tvDate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="الخميس" android:textColor="#B0BEC5" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="12:00" android:textColor="#90CAF9" android:textSize="15sp" android:textStyle="bold"/>
                </LinearLayout>
                <TextView android:id="@+id/tvLocation" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📍 المعرض الرئيسي" android:textColor="#78909C" android:textSize="11sp" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- KPI -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="📊 المخزون" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
            <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="90dp" android:layout_weight="1" android:layout_marginEnd="4dp"
                app:cardCornerRadius="14dp" app:cardElevation="3dp" app:cardBackgroundColor="#1A1E3A">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="10dp">
                    <TextView android:text="💍" android:textSize="26sp"/>
                    <TextView android:id="@+id/tvTotalItems" android:text="5,234" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
                    <TextView android:text="قطعة" android:textColor="#9FA8DA" android:textSize="11sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="90dp" android:layout_weight="1" android:layout_marginHorizontal="4dp"
                app:cardCornerRadius="14dp" app:cardElevation="3dp" app:cardBackgroundColor="#1A1E3A">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="10dp">
                    <TextView android:text="⚖️" android:textSize="26sp"/>
                    <TextView android:id="@+id/tvTotalWeight" android:text="12.5 kg" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
                    <TextView android:text="الوزن" android:textColor="#9FA8DA" android:textSize="11sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="90dp" android:layout_weight="1" android:layout_marginStart="4dp"
                app:cardCornerRadius="14dp" app:cardElevation="3dp" app:cardBackgroundColor="#1A1E3A">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="10dp">
                    <TextView android:text="💰" android:textSize="26sp"/>
                    <TextView android:id="@+id/tvTotalValue" android:text="$245K" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
                    <TextView android:text="القيمة" android:textColor="#9FA8DA" android:textSize="11sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- مبيعات -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="💹 المبيعات" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="65dp" android:layout_weight="1" android:layout_marginEnd="3dp"
                android:background="#1B5E20" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tvSoldToday" android:text="12" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:text="اليوم" android:textColor="#A5D6A7" android:textSize="11sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="65dp" android:layout_weight="1" android:layout_marginHorizontal="3dp"
                android:background="#0D47A1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tvSoldWeek" android:text="47" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:text="الأسبوع" android:textColor="#90CAF9" android:textSize="11sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="65dp" android:layout_weight="1" android:layout_marginStart="3dp"
                android:background="#4A148C" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tvSoldMonth" android:text="189" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:text="الشهر" android:textColor="#CE93D8" android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- الأمن -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🔐 الأمن" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_marginEnd="3dp"
                android:background="#1A1E3A" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tvActiveGates" android:text="3" android:textColor="#4CAF50" android:textSize="20sp" android:textStyle="bold"/>
                <TextView android:text="🚪 بوابات" android:textColor="#9FA8DA" android:textSize="10sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_marginHorizontal="3dp"
                android:background="#1A1E3A" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tvAlertsToday" android:text="2" android:textColor="#F44336" android:textSize="20sp" android:textStyle="bold"/>
                <TextView android:text="🚨 تنبيهات" android:textColor="#9FA8DA" android:textSize="10sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_marginStart="3dp"
                android:background="#1A1E3A" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tvOnlineUsers" android:text="8" android:textColor="#FF9800" android:textSize="20sp" android:textStyle="bold"/>
                <TextView android:text="👥 مستخدمين" android:textColor="#9FA8DA" android:textSize="10sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- حالة النظام -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🖥️ حالة النظام" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="12dp" app:cardBackgroundColor="#1A1E3A" android:layout_marginBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <View android:id="@+id/indicatorApi" android:layout_width="8dp" android:layout_height="8dp" android:background="#4CAF50" android:layout_marginEnd="8dp"/>
                    <TextView android:text="MIRA API: متصل" android:textColor="#81C784" android:textSize="12sp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <View android:id="@+id/indicatorDb" android:layout_width="8dp" android:layout_height="8dp" android:background="#4CAF50" android:layout_marginEnd="8dp"/>
                    <TextView android:text="قاعدة البيانات: نشطة" android:textColor="#81C784" android:textSize="12sp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <View android:id="@+id/indicatorGate" android:layout_width="8dp" android:layout_height="8dp" android:background="#4CAF50" android:layout_marginEnd="8dp"/>
                    <TextView android:text="البوابات: متصلة" android:textColor="#81C784" android:textSize="12sp"/>
                </LinearLayout>
                <TextView android:id="@+id/tvLastSync" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="آخر مزامنة: --:--" android:textColor="#546E7A" android:textSize="10sp" android:layout_marginTop="8dp" android:gravity="end"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- نشاط حديث -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="📋 نشاط حديث" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="#1A1E3A" android:padding="12dp" android:layout_marginBottom="16dp">
            <TextView android:id="@+id/tvRecent1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="-" android:textColor="#B0BEC5" android:textSize="12sp" android:paddingVertical="5dp"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2E4A"/>
            <TextView android:id="@+id/tvRecent2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="-" android:textColor="#EF9A9A" android:textSize="12sp" android:paddingVertical="5dp"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2E4A"/>
            <TextView android:id="@+id/tvRecent3" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="-" android:textColor="#B0BEC5" android:textSize="12sp" android:paddingVertical="5dp"/>
        </LinearLayout>

        <!-- وصول سريع -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="⚡ وصول سريع" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="20dp">
            <LinearLayout android:id="@+id/cardScan" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_marginEnd="3dp"
                android:background="#1A1E3A" android:orientation="vertical" android:gravity="center">
                <TextView android:text="📷" android:textSize="24sp"/>
                <TextView android:text="مسح" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/cardGate" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_marginHorizontal="3dp"
                android:background="#1A1E3A" android:orientation="vertical" android:gravity="center">
                <TextView android:text="🚪" android:textSize="24sp"/>
                <TextView android:text="بوابة" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/cardRadar" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_marginHorizontal="3dp"
                android:background="#1A1E3A" android:orientation="vertical" android:gravity="center">
                <TextView android:text="📡" android:textSize="24sp"/>
                <TextView android:text="رادار" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/cardSettings" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_marginHorizontal="3dp"
                android:background="#1A1E3A" android:orientation="vertical" android:gravity="center">
                <TextView android:text="⚙️" android:textSize="24sp"/>
                <TextView android:text="إعدادات" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/cardInventory" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_marginHorizontal="3dp"
                android:background="#1A1E3A" android:orientation="vertical" android:gravity="center">
                <TextView android:text="📋" android:textSize="24sp"/>
                <TextView android:text="جرد" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/cardReports" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_marginStart="3dp"
                android:background="#1A1E3A" android:orientation="vertical" android:gravity="center">
                <TextView android:text="📊" android:textSize="24sp"/>
                <TextView android:text="تقارير" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- تذييل -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:orientation="vertical" android:layout_marginTop="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="MIRA ID" android:textColor="#3F51B5" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Digital Trust Platform" android:textColor="#546E7A" android:textSize="8sp"/>
            <TextView android:id="@+id/tvSystemStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🟢 جميع الأنظمة تعمل" android:textColor="#4CAF50" android:textSize="10sp" android:layout_marginTop="4dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
